# Backend API base URL. Falls back to http://localhost:8000/api/v1 if unset
# (see src/services/api.js), so this is only required when the backend
# isn't running on localhost:8000 -- e.g. staging/production.
REACT_APP_API_URL=http://localhost:8000/api/v1

# Google Maps JavaScript API key, used by the location picker during
# listing/host onboarding (src/components/onboarding/LocationPicker.js).
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
