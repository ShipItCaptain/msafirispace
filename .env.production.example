# Production secrets for docker-compose.prod.yml, on the VPS only.
# Copy to .env.production (gitignored) and fill in real values -- never commit it.
#
# This is separate from backend/.env, which python-decouple reads INSIDE the
# backend container during local dev. docker-compose.prod.yml instead reads
# this file to fill in the ${VAR} placeholders in its own `environment:` lists.
#
# Usage: docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Postgres password -- pick something real, this isn't the dev default.
POSTGRES_PASSWORD=

# Gmail SMTP (same pattern already proven working for dev/pilot -- see d6-2)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Paystack dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Safaricom Daraja (from the go-live application, Day 7)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENVIRONMENT=production

# Cloudinary dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# USE_CLOUDINARY_STORAGE defaults to `not DEBUG` -- since DEBUG=0 in
# production below, it turns on automatically even with the CLOUDINARY_*
# vars above still blank, which breaks image upload/serving. Leave this
# explicitly False until Cloudinary (d6-1) is actually set up, then delete
# this line (or set it True) once CLOUDINARY_* above are filled in.
USE_CLOUDINARY_STORAGE=False
