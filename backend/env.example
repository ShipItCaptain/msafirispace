# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://msafiri_user:msafiri_password@localhost:5432/msafiri_space

# Cache backend: "redis" (default) or "database" (no Redis needed -- for
# hosts without it, e.g. Namecheap shared hosting; needs a one-time
# `python manage.py createcachetable` first).
CACHE_BACKEND=redis

# Redis (only used when CACHE_BACKEND=redis)
REDIS_URL=redis://127.0.0.1:6379/0

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email Configuration
# Local default prints emails (including OTP codes) to the Django runserver console.
# For real inbox delivery, switch to SMTP and set a real from-address + app password.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Msafiri Space <noreply@msafirispace.com>

# OTP / Verification Code Settings
OTP_CODE_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Reserved for future WhatsApp/SMS provider selection (email always uses EMAIL_* above)
OTP_SENDER_BACKEND=console

# Payment Gateways
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_PASSKEY=your-mpesa-passkey
MPESA_SHORTCODE=your-mpesa-shortcode
MPESA_ENVIRONMENT=sandbox
# Comma-separated Safaricom callback source IPs, from the Daraja go-live paperwork. Leave blank to disable IP filtering.
MPESA_WEBHOOK_ALLOWED_IPS=

PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_ENVIRONMENT=test

# Site URL
SITE_URL=http://localhost:3000

# Africa's Talking (future WhatsApp/SMS OTP provider -- not yet integrated,
# placeholder only so the pluggable sender has somewhere to read creds from later)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
